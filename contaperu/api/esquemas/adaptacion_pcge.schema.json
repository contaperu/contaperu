{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://raw.githubusercontent.com/contaperu/contaperu/main/contaperu/api/esquemas/adaptacion_pcge.schema.json",
 "title": "Adaptación al PCGE 2026",
 "description": "Las líneas con las equivalencias aplicadas y el informe; sin la tabla oficial, intactas y con `sin_tabla`.",
 "type": "object",
 "properties": {
  "asiento": {
   "type": "array",
   "items": {
    "$ref": "https://raw.githubusercontent.com/contaperu/contaperu/open-accounting-1.0/estandar/open-accounting.schema.json#/$defs/linea"
   }
  },
  "informe": {
   "type": "object",
   "properties": {
    "version": {
     "type": "string"
    },
    "fuente": {
     "type": "string"
    },
    "sin_tabla": {
     "type": "boolean"
    },
    "cambios": {
     "type": "integer",
     "minimum": 0
    },
    "aplicados": {
     "type": "array"
    }
   },
   "required": [
    "sin_tabla",
    "cambios",
    "aplicados"
   ],
   "additionalProperties": true
  }
 },
 "required": [
  "asiento",
  "informe"
 ],
 "additionalProperties": false
}
