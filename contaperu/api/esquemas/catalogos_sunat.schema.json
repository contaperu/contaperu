{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://raw.githubusercontent.com/contaperu/contaperu/main/contaperu/api/esquemas/catalogos_sunat.schema.json",
 "title": "Catálogos de SUNAT",
 "description": "Los tipos de comprobante, los tipos de documento de identidad, las monedas y los medios de pago que entiende el motor.",
 "type": "object",
 "properties": {
  "tipos_comprobante": {
   "type": "object"
  },
  "medios_pago": {
   "type": "object",
   "description": "Tabla 1 del Anexo 3 de la RS 169-2015: el código de medio de pago y su descripción.",
   "additionalProperties": {
    "type": "string"
   }
  },
  "tipos_documento_identidad": {
   "type": "object"
  },
  "monedas": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "notas": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "fuera_del_registro_sunat": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "detracciones": {
   "type": "object",
   "description": "La tabla de detracciones del motor, con su fuente: cada código SUNAT con su nombre y su tasa. El ERP que integra el motor la puede sobreescribir en su configuración (detraccion_tasas, detraccion_nombres).",
   "properties": {
    "fuente": {
     "type": "string"
    },
    "nota": {
     "type": "string"
    },
    "codigos": {
     "type": "object",
     "additionalProperties": {
      "type": "object",
      "properties": {
       "nombre": {
        "type": "string"
       },
       "tasa": {
        "type": [
         "string",
         "null"
        ]
       }
      },
      "required": [
       "nombre",
       "tasa"
      ],
      "additionalProperties": false
     }
    }
   },
   "required": [
    "fuente",
    "codigos"
   ],
   "additionalProperties": false
  },
  "fuentes": {
   "type": "object",
   "description": "De dónde sale cada catálogo (tipos_comprobante, tipos_documento_identidad, monedas, medios_pago): la norma y su tabla.",
   "additionalProperties": {
    "type": "string"
   }
  }
 },
 "required": [
  "tipos_comprobante",
  "tipos_documento_identidad",
  "monedas",
  "medios_pago",
  "notas",
  "fuera_del_registro_sunat",
  "detracciones",
  "fuentes"
 ],
 "additionalProperties": false
}
